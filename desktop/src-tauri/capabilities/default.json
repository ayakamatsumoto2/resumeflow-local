{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "榫卯简历窗口的权限：只允许向 https 地址和本机地址发请求（模型服务由用户自己在设置里填写）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
